# Copy to .env (gitignored) and fill in. Never commit .env.
#
# .env lookup: LSS_ENV_FILE if set, else .env at the repo root.
# Worktrees can point LSS_ENV_FILE at the main repo's .env instead of copying it.

# Cesium ion access token for the 3D Moon globe. PUBLIC by design: it ships in
# the browser bundle. Restrict it to the Cesium Moon Terrain asset and the
# deployed web domain in the ion dashboard. Injected at web build time.
CESIUM_ION_TOKEN=

# Anthropic API key for the natural-language layer. Server-side only.
ANTHROPIC_API_KEY=

# Shared data folder (outside the repos) with data/, cache/, kernels/ inside.
# Default if unset: C:\dev\data\nasa-lunar-site-scout
LSS_DATA_DIR=C:\dev\data\nasa-lunar-site-scout

# Optional: absolute path to the .env to load (set in the process environment,
# e.g. in a worktree shell; setting it inside .env itself has no effect).
LSS_ENV_FILE=

# Optional: comma-separated browser origins allowed by the API (CORS).
# Default: http://localhost:5173 (Vite dev server).
LSS_CORS_ORIGINS=
