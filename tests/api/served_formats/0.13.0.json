        "earth": {
          "$ref": "#/components/schemas/BodyTrack"
        },
        "events": {
          "items": {
            "$ref": "#/components/schemas/Event"
          },
          "type": "array"
        },
        "scenario": {
          "$ref": "#/components/schemas/Scenario"
        },
