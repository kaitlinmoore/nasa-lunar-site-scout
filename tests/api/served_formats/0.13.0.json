        "mean_visible_disk_fraction": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "shadow_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "sun_azimuth_deg": {
          "$ref": "#/components/schemas/Stat"
        },
        "sun_elevation_deg": {
          "$ref": "#/components/schemas/Stat"
        },
        "sunlit_duration_h": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "sunset_in_window": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "time_to_sunset_h": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "Scenario": {
      "additionalProperties": false,
      "properties": {
        "location": {
          "$ref": "#/components/schemas/Location"
        },
        "step": {
          "default": "PT1H",
          "format": "duration",
          "type": "string"
        },
        "unit_height_m": {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        "window_end": {
          "format": "date-time",
          "type": "string"
        },
        "window_start": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "location",
        "unit_height_m",
        "window_start",
        "window_end"
      ],
      "type": "object"
    },
    "SeriesResponse": {
      "additionalProperties": false,
      "properties": {
        "_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
