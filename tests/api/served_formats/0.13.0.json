{
  "contract_version": "0.13.0",
  "schemas": {
    "BodyTrack": {
      "additionalProperties": false,
      "properties": {
        "azimuth_deg": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "clearance_deg": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "elevation_deg": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "visible_fraction": {
          "items": {
            "maximum": 1.0,
            "minimum": 0.0,
            "type": "number"
          },
          "type": "array"
        }
      },
      "required": [
        "azimuth_deg",
        "elevation_deg",
        "visible_fraction"
      ],
      "type": "object"
    },
    "CommsMetrics": {
      "additionalProperties": false,
      "properties": {
        "earth_clearance_deg": {
          "$ref": "#/components/schemas/Stat"
        },
        "earth_elevation_deg": {
          "$ref": "#/components/schemas/Stat"
        },
        "earth_full_disc_fraction": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "earth_visibility_fraction": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "earthset_in_window": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "longest_earth_gap_clipped": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "longest_earth_gap_h": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "sun_earth_overlap_fraction": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "time_to_earthset_h": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "Event": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/components/schemas/EventKind"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "refined": {
          "default": false,
          "type": "boolean"
        },
        "time": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "time"
      ],
      "type": "object"
    },
    "EventKind": {
      "enum": [
        "sunrise",
        "sunset",
        "earthrise",
        "earthset"
      ],
      "type": "string"
    },
    "FidelityLabel": {
      "additionalProperties": false,
      "properties": {
        "far_field_resolution_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "near_field_resolution_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
