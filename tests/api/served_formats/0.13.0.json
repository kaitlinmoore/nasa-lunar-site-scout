        "fidelity": {
          "anyOf": [
            {
              "$ref": "#/components/schemas/FidelityLabel"
            },
            {
              "type": "null"
            }
          ]
        },
        "location": {
          "$ref": "#/components/schemas/Location"
        },
        "max_range_km": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "terrain_stack": {
          "items": {
            "$ref": "#/components/schemas/TerrainLayer"
          },
          "type": "array"
        },
        "unit_height_m": {
          "type": "number"
        }
      },
      "required": [
        "location",
        "unit_height_m",
        "azimuth_deg",
        "elevation_deg"
      ],
      "type": "object"
    },
    "Location": {
      "additionalProperties": false,
      "properties": {
        "lat": {
          "maximum": 90.0,
          "minimum": -90.0,
          "type": "number"
        },
        "lon": {
          "maximum": 180.0,
          "minimum": -180.0,
          "type": "number"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "lat",
        "lon"
      ],
      "type": "object"
    },
    "MetricsResponse": {
      "additionalProperties": false,
      "properties": {
        "_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
