          "type": "string"
        },
        "tier": {
          "$ref": "#/components/schemas/FidelityTier"
        }
      },
      "required": [
        "tier",
        "summary"
      ],
      "type": "object"
    },
    "FidelityTier": {
      "enum": [
        "high",
