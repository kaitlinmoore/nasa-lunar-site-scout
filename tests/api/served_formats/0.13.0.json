        "_placeholder": {
          "default": false,
          "type": "boolean"
        },
        "azimuth_deg": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "contract_version": {
          "type": "string"
        },
        "elevation_deg": {
          "items": {
            "type": "number"
          },
          "type": "array"
