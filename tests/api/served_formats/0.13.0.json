          "$ref": "#/components/schemas/Location"
        },
        "radius_m": {
          "type": "number"
        },
        "slope_at_point_deg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "slope_deg": {
          "$ref": "#/components/schemas/Stat"
        },
        "slope_layer": {
          "anyOf": [
            {
              "$ref": "#/components/schemas/TerrainLayer"
