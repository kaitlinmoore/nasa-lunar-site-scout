        "max_range_km": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "resolution_m": {
          "type": "number"
        },
        "role": {
          "enum": [
            "near_field",
            "far_field"
